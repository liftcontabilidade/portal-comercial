rules_version = '2';

// ============================================================================
// REGRAS DO FIRESTORE — Portal Comercial LIFT
// Console do Firebase → Firestore Database → aba "Regras" → colar → Publicar.
//
// Só os e-mails da lista abaixo (entrando com Google) leem e gravam os dados
// do portal (pasta "portalComercial"). Para dar acesso a mais alguém,
// acrescente o e-mail na lista e publique de novo.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== PORTAL COMERCIAL: só e-mails autorizados =====
    function acessoPortalComercial() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'contato@liftcontabilidade.com',
          'comercialliftcontabilidade@gmail.com'
        ];
    }

    match /portalComercial/{documento=**} {
      allow read, write: if acessoPortalComercial();
    }

    // ===== DEMAIS DADOS DO PROJETO: continuam como antes =====
    // (outros sistemas que usam este mesmo Firebase)
    match /{colecao}/{documento=**} {
      allow read, write: if colecao != 'portalComercial';
    }
  }
}
